# Optional local source directory containing Champion Fit CSV/JSON outputs.
CHAMPION_FIT_SOURCE=./data

# Optional PostgreSQL storage URL. SQLite is the default when this is empty.
CHAMPION_FIT_DATABASE_URL=postgresql://champion_fit:change-me@localhost:5432/champion_fit
POSTGRES_PASSWORD=change-me

# Optional Riot Data Dragon catalog version.
DDRAGON_VERSION=16.13.1

# Riot synchronization. Keep real keys and account IDs outside the repository.
RIOT_API_KEY=
RIOT_API_KEYS=
RIOT_ACCOUNTS=
